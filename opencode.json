{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp"
    },
    "netlify": {
      "type": "local",
      "command": ["npx", "-y", "@netlify/mcp"],
      "env": {
        "NETLIFY_AUTH_TOKEN": "env:NETLIFY_AUTH_TOKEN"
      }
    }
  }
}
